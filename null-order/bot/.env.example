# Telegram Bot API token from @BotFather
BOT_TOKEN=

# Comma-separated Telegram user IDs with ARCHITECT-level access
ADMIN_IDS=

# Optional: channel/group IDs for reminders (negative for groups/channels)
BULLETIN_CHANNEL_ID=
CORE_GROUP_ID=

# Bot username without @ (used in recruitment template)
BOT_USERNAME=

# Timezone for content calendar reminders
TIMEZONE=Asia/Shanghai

# Path to null-order root (auto-detected if empty)
NULL_ORDER_ROOT=
